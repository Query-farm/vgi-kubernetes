# name: test/sql/kubernetes.test
# description: Core resource tables against the kind fixture (ci/kind-fixture.sh), as the read-only vgi-sql ServiceAccount
# group: [kubernetes]

require vgi

statement ok
LOAD json;

require-env KUBERNETES_WORKER

require-env KUBERNETES_FIXTURE_SERVER

require-env KUBERNETES_FIXTURE_TOKEN

require-env KUBERNETES_FIXTURE_CA

statement ok
ATTACH 'kubernetes' (TYPE vgi, LOCATION '{KUBERNETES_WORKER}');

statement ok
CREATE SECRET k8s (TYPE kubernetes, SERVER '{KUBERNETES_FIXTURE_SERVER}', TOKEN '{KUBERNETES_FIXTURE_TOKEN}', CERTIFICATE_AUTHORITY_DATA '{KUBERNETES_FIXTURE_CA}');

# ---------------------------------------------------------------- cluster

query T
SELECT git_version LIKE 'v1.%' FROM kubernetes.main.api_servers;
----
true

query TTT
SELECT name, phase, labels['pod-security.kubernetes.io/enforce'] FROM kubernetes.main.namespaces WHERE name = 'vgi-fixture';
----
vgi-fixture	Active	baseline

query TTTT
SELECT ready, unschedulable, roles, labels['vgi.query.farm/fixture'] FROM kubernetes.main.nodes;
----
true	false	[control-plane]	true

query T
SELECT allocatable_cpu_millicores > 0 AND allocatable_memory_bytes > 0 AND capacity_pods > 0 AND len(conditions) >= 4 FROM kubernetes.main.nodes;
----
true

query TT
SELECT value, preemption_policy FROM kubernetes.main.priorityclasses WHERE name = 'vgi-fixture-high';
----
100000	Never

# ---------------------------------------------------------------- pods

query T
SELECT count(*) FROM kubernetes.main.pods WHERE namespace = 'vgi-fixture';
----
7

# phase -> fieldSelector status.phase, label_selector -> labelSelector (echoed).
query TTT
SELECT phase, label_selector, controller_kind FROM kubernetes.main.pods WHERE namespace = 'vgi-fixture' AND phase = 'Succeeded' AND label_selector = 'app=pi';
----
Succeeded	app=pi	Job

# Pod-level requests are numbers summed over app containers: 50m+10m CPU, 32Mi+16Mi memory.
query IIIITT
SELECT count(*), sum(cpu_request_millicores), sum(memory_request_bytes), sum(memory_limit_bytes), bool_and(ready), list_distinct(flatten(list(images))) FROM kubernetes.main.pods WHERE namespace = 'vgi-fixture' AND label_selector = 'app=web';
----
2	120	100663296	134217728	1	['busybox:1.36']

# labels['...'] is not a selector, but the worker still filters exactly.
query I
SELECT count(*) FROM kubernetes.main.pods WHERE labels['tier'] = 'frontend' AND namespace = 'vgi-fixture';
----
2

query I
SELECT count(*) FROM kubernetes.main.pods WHERE name LIKE 'web-%' AND namespace IN ('vgi-fixture', 'default');
----
2

# The crash-looping pod: restarted, not ready, last instance exited 3.
query TTTT
SELECT ready, restart_count > 0, containers[1].last_termination_exit_code, priority_class_name FROM kubernetes.main.pods WHERE namespace = 'vgi-fixture' AND name = 'crashy';
----
false	true	3	vgi-fixture-high

query T
SELECT containers[1].state IN ('waiting', 'terminated', 'running') FROM kubernetes.main.pods WHERE namespace = 'vgi-fixture' AND name = 'crashy';
----
true

# node_name -> fieldSelector spec.nodeName: an unknown node matches nothing.
query I
SELECT count(*) FROM kubernetes.main.pods WHERE node_name = 'no-such-node';
----
0

query I
SELECT count(*) FROM kubernetes.main.pods WHERE node_name = (SELECT name FROM kubernetes.main.nodes) AND namespace = 'vgi-fixture';
----
7

# pod_containers: one row per container; the web pods have two each.
query TTIII
SELECT container_name, kind, count(*), sum(cpu_request_millicores), max(memory_limit_bytes) FROM kubernetes.main.pod_containers WHERE namespace = 'vgi-fixture' AND pod_name LIKE 'web-%' GROUP BY ALL ORDER BY container_name;
----
sidecar	app	2	20	NULL
web	app	2	100	67108864

query I
SELECT count(*) FROM kubernetes.main.pod_containers WHERE namespace = 'vgi-fixture' AND last_termination_reason = 'Error';
----
1

# ---------------------------------------------------------------- workloads

query IIITTTT
SELECT replicas, ready_replicas, available_replicas, strategy, max_surge, available, images FROM kubernetes.main.deployments WHERE namespace = 'vgi-fixture' AND name = 'web';
----
2	2	2	RollingUpdate	1	true	['busybox:1.36']

query TT
SELECT containers[1].name, containers[1].ports FROM kubernetes.main.deployments WHERE namespace = 'vgi-fixture' AND name = 'web';
----
web	[8080]

query ITT
SELECT replicas, revision, owner_references[1].kind FROM kubernetes.main.replicasets WHERE namespace = 'vgi-fixture' AND name LIKE 'web-%';
----
2	1	Deployment

query IITT
SELECT replicas, ready_replicas, service_name, volume_claim_templates FROM kubernetes.main.statefulsets WHERE namespace = 'vgi-fixture';
----
1	1	db	[storage]

query IIT
SELECT desired_number_scheduled, number_ready, update_strategy FROM kubernetes.main.daemonsets WHERE namespace = 'vgi-fixture';
----
1	1	RollingUpdate

query TIIIT
SELECT status, succeeded, failed, backoff_limit, duration_seconds >= 0 FROM kubernetes.main.jobs WHERE namespace = 'vgi-fixture' AND name = 'pi';
----
Complete	1	0	0	true

query TTTTT
SELECT schedule, time_zone, suspend, concurrency_policy, last_schedule_time FROM kubernetes.main.cronjobs WHERE namespace = 'vgi-fixture';
----
0 3 * * *	Etc/UTC	true	Forbid	NULL

query TTIIT
SELECT target_kind, target_name, min_replicas, max_replicas, metrics->>'$[0].resource.name' FROM kubernetes.main.horizontalpodautoscalers WHERE namespace = 'vgi-fixture';
----
Deployment	web	2	4	cpu

# ---------------------------------------------------------------- networking

query TTTT
SELECT type, ports[1].port, ports[1].target_port, selector_labels FROM kubernetes.main.services WHERE namespace = 'vgi-fixture' AND name = 'web';
----
ClusterIP	80	8080	{app=web}

query I
SELECT count(*) FROM kubernetes.main.services WHERE type = 'ClusterIP' AND namespace = 'vgi-fixture';
----
1

query TII
SELECT address_type, sum(endpoint_count), sum(ready_count) FROM kubernetes.main.endpointslices WHERE namespace = 'vgi-fixture' AND service_name = 'web' GROUP BY ALL;
----
IPv4	2	2

query TTTTT
SELECT hosts, rules[1].path, rules[1].path_type, rules[1].service_name, rules[1].service_port FROM kubernetes.main.ingresses WHERE namespace = 'vgi-fixture';
----
[web.example.com]	/	Prefix	web	80

query TTTTII
SELECT name, selects_all_pods, default_deny_ingress, policy_types, ingress_rule_count, egress_rule_count FROM kubernetes.main.networkpolicies WHERE namespace = 'vgi-fixture' ORDER BY name;
----
default-deny-ingress	true	true	[Ingress]	0	0
web-from-frontend	false	false	[Ingress]	1	0

query T
SELECT ingress->>'$[0].from[0].podSelector.matchLabels.tier' FROM kubernetes.main.networkpolicies WHERE namespace = 'vgi-fixture' AND name = 'web-from-frontend';
----
frontend

# ---------------------------------------------------------------- config: values never leak

query TTT
SELECT type, keys, annotations['kubectl.kubernetes.io/last-applied-configuration'] FROM kubernetes.main.secrets WHERE namespace = 'vgi-fixture' AND name = 'db-credentials';
----
Opaque	[password, username]	<redacted>

query I
SELECT count(*) FROM kubernetes.main.secrets WHERE namespace = 'vgi-fixture' AND type = 'Opaque';
----
1

# No column of any secrets row contains the value, in any form.
query I
SELECT count(*) FROM kubernetes.main.secrets s WHERE CAST(s AS VARCHAR) LIKE '%fixture-password%';
----
0

query TT
SELECT keys, data FROM kubernetes.main.configmaps WHERE namespace = 'vgi-fixture' AND name = 'app-config';
----
[feature_flags, log_level]	NULL

query TTT
SELECT automount_service_account_token, secrets, image_pull_secrets FROM kubernetes.main.serviceaccounts WHERE namespace = 'vgi-fixture' AND name = 'reporter';
----
false	[]	[]

# ---------------------------------------------------------------- storage

query TTTIT
SELECT name, phase, storage_class, requested_bytes, access_modes FROM kubernetes.main.persistentvolumeclaims WHERE namespace = 'vgi-fixture' ORDER BY name;
----
data	Pending	standard	1073741824	[ReadWriteOnce]
storage-db-0	Bound	standard	268435456	[ReadWriteOnce]

query TIT
SELECT phase, capacity_bytes, source_type IS NOT NULL FROM kubernetes.main.persistentvolumes WHERE claim_namespace = 'vgi-fixture' AND claim_name = 'storage-db-0';
----
Bound	268435456	true

query TTT
SELECT name, is_default, volume_binding_mode FROM kubernetes.main.storageclasses ORDER BY name;
----
standard	true	WaitForFirstConsumer

# ---------------------------------------------------------------- RBAC

query TT
SELECT len(rules), rules[2].resource_names FROM kubernetes.main.roles WHERE namespace = 'vgi-fixture' AND name = 'secret-reader';
----
2	[app-config]

query TTT
SELECT role_kind, role_name, [s.kind || ':' || s.name FOR s IN subjects] FROM kubernetes.main.rolebindings WHERE namespace = 'vgi-fixture';
----
Role	secret-reader	['ServiceAccount:reporter', 'User:alice']

query TTT
SELECT rules[1].verbs, rules[1].resources, aggregated FROM kubernetes.main.clusterroles WHERE name = 'vgi-sql-reader';
----
[get, list, watch]	[*]	false

query T
SELECT aggregated FROM kubernetes.main.clusterroles WHERE name = 'admin';
----
true

query TT
SELECT role_name, subjects[1].namespace FROM kubernetes.main.clusterrolebindings WHERE name = 'vgi-sql-reader';
----
vgi-sql-reader	vgi-fixture

query TTTITTT
SELECT role_kind, namespace, role_name, rule_index, api_group, resource, verb FROM kubernetes.main.rbac_rules WHERE namespace = 'vgi-fixture' ORDER BY ALL;
----
Role	vgi-fixture	secret-reader	0	(empty)	secrets	get
Role	vgi-fixture	secret-reader	0	(empty)	secrets	list
Role	vgi-fixture	secret-reader	1	(empty)	configmaps	get

# role_name -> fieldSelector metadata.name, across both Roles and ClusterRoles.
query TTTT
SELECT role_kind, namespace, verb, non_resource_url FROM kubernetes.main.rbac_rules WHERE role_name = 'vgi-sql-reader' AND non_resource_url IS NOT NULL ORDER BY non_resource_url;
----
ClusterRole	NULL	get	/api
ClusterRole	NULL	get	/api/*
ClusterRole	NULL	get	/apis
ClusterRole	NULL	get	/apis/*
ClusterRole	NULL	get	/version

query TTTTT
SELECT binding_kind, namespace, role_name, subject_kind, subject_namespace FROM kubernetes.main.rbac_subjects WHERE subject_name IN ('reporter', 'alice', 'vgi-sql') ORDER BY ALL;
----
ClusterRoleBinding	NULL	vgi-sql-reader	ServiceAccount	vgi-fixture
RoleBinding	vgi-fixture	secret-reader	ServiceAccount	vgi-fixture
RoleBinding	vgi-fixture	secret-reader	User	NULL

query I
SELECT count(*) - count(DISTINCT id) FROM kubernetes.main.rbac_rules;
----
0

# ---------------------------------------------------------------- events

query TTITT
SELECT type, reason, count, involved_kind, source_component FROM kubernetes.main.events WHERE namespace = 'vgi-fixture' AND reason = 'FixtureWarning';
----
Warning	FixtureWarning	3	Pod	vgi-fixture

query I
SELECT count(*) > 0 FROM kubernetes.main.events WHERE namespace = 'vgi-fixture' AND involved_kind = 'Pod' AND involved_name = 'crashy' AND reason = 'BackOff';
----
true

# TIMESTAMPTZ filters. The runner has no ICU, so the session is UTC (vgi-go 0.42.0 rejects
# these pushed filters in a non-UTC TimeZone; see README Limitations).

query T
SELECT last_seen FROM kubernetes.main.events WHERE namespace = 'vgi-fixture' AND reason = 'FixtureWarning' AND last_seen > TIMESTAMPTZ '2025-12-31 00:00:00+00';
----
2026-01-01 00:05:00+00

query I
SELECT count(*) FROM kubernetes.main.pods WHERE namespace = 'vgi-fixture' AND creation_timestamp < TIMESTAMPTZ '2000-01-01 00:00:00+00';
----
0

# ---------------------------------------------------------------- empty and impossible filters

query I
SELECT count(*) FROM kubernetes.main.pods WHERE namespace = 'no-such-namespace';
----
0

query I
SELECT count(*) FROM kubernetes.main.pods WHERE namespace = 'a' AND namespace = 'b';
----
0

query I
SELECT count(*) FROM kubernetes.main.pods WHERE label_selector = 'app=web' AND label_selector = 'app=db';
----
0

statement error
SELECT count(*) FROM kubernetes.main.pods WHERE label_selector = 'app in web';
----
<REGEX>:.*400.*

statement ok
DETACH kubernetes;
